# Demo server (Hostinger shared hosting): shows the product to the restaurant
# owner. Not production: a sale gets its own hosting (docs/DEPLOYMENT.md §9).
#
# On the server: cp .env.staging.example .env && chmod 600 .env, then fill in
# every TODO. NEVER commit the real .env. Runbook: docs/DEPLOYMENT.md §3.5.

APP_NAME="Ahl Al Karam API (demo)"
# staging, not production: strict Eloquent mode stays on, and migrate:fresh is
# allowed so the demo can be reset to clean seed data (docs/DEPLOYMENT.md §5).
APP_ENV=staging
# Generated on the server (docs/DEPLOYMENT.md §3.6), never copied from local.
APP_KEY=
# Always false on a server: bin/deploy.sh refuses true.
APP_DEBUG=false
# TODO: https://<the demo subdomain>. Image URLs are built from it.
APP_URL=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One file per day, kept 14 days: storage/logs/laravel-YYYY-MM-DD.log
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hostinger MySQL: a database and user of their own (never root).
# TODO DB_HOST: the host hPanel → Databases shows, never localhost or 127.0.0.1.
# TODO DB_DATABASE / DB_USERNAME: e.g. u<id>_restaurant_demo.
# TODO DB_PASSWORD: from hPanel, in double quotes if it has # $ space & ( ) !
# (Keep comments on their own lines: bin/deploy.sh reads some values raw.)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# No sessions (Bearer tokens only), no Redis, no queue worker on shared hosting.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Cache and rate limits in the database (the cache table).
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared secret with the Next.js server. Generate ON THE SERVER:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Sent to the frontend owner privately (password manager), never committed.
# TODO FRONTEND_API_KEY
FRONTEND_API_KEY=
# Every /api/v1 request needs X-Frontend-Key: only her server and our Postman
# get in (decision 5.6). bin/deploy.sh refuses true with an empty key.
API_REQUIRE_FRONTEND_KEY=true
